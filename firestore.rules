rules_version = '2';

// Security rules for the Amharic App's optional accounts (see site/js/cloud.js).
// Paste this whole file into Firebase console > Firestore Database > Rules, then click Publish.
//
// Each signed-in person can read, write and delete only their own document, users/<their account id>.
// Nobody can list other people's documents, and everything else in the database is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'data', 'updated', 'v'])
          && d.keys().hasAll(['name', 'data', 'updated', 'v'])
          && d.name is string && d.name.size() <= 40
          && d.data is string && d.data.size() <= 900000
          && d.updated is int
          && d.v is int;
      }

      allow get: if isOwner();
      allow create, update: if isOwner() && validShape();
      allow delete: if isOwner();
      allow list: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
